ENV=prod

# Required, deployment-specific signing secrets. Generate each independently:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Missing/blank/weak values or the previously published key prevent startup.
# Rotate both after exposure; restart every web, WebSocket and worker process.
SECRET_KEY=
JWT_SIGNING_KEY=

POSTGRES_HOST=postgres
POSTGRES_DB=watchtower
POSTGRES_USER=postgres
POSTGRES_PASSWORD=badpassword

# Production Compose mounts credentials read-only under /run/watchtower-credentials.
# Local development may override these paths.
GOOGLE_APP_CREDENTIALS_PATH=/run/watchtower-credentials/firebase-admin-credentials.json
GOOGLE_CLOUD_MESSAGING_API_KEY=gcm-api-key
APNS_AUTH_KEY_PATH=/run/watchtower-credentials/APNS_AuthKey.p8
APNS_AUTH_KEY_ID=
APNS_TEAM_ID=
APNS_USE_ALTERNATIVE_PORT=
APNS_USE_SANDBOX=
APNS_TOPIC=

# JPP "Payment Request" push (sent on invoice creation). Off unless set to True;
# leave unset in production until the invoice endpoint proves caller ownership.
JPP_PAYMENT_REQUEST_PUSH_ENABLED=

TELEGRAM_BOT_TOKEN=
TELGRAM_BOT_USER=watchtower_bot

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SLACK_BOT_USER_TOKEN=
SLACK_VERIFICATION_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# HMAC key for wallet lookup keys. Independent of SECRET_KEY on purpose:
# rotating SECRET_KEY would otherwise invalidate every issued lookup key.
# Generate with: python -c "from django.utils.crypto import get_random_string; print(get_random_string(50))"
# Leave blank to fall back to SECRET_KEY.
LOOKUP_KEY_SECRET=

SBCH_START_BLOCK=3790573
BLOCK_TO_PRELOAD=25
SBCH_BLOCKS_PER_TASK=25
TOTP_SECRET_KEY=xxxx

ANYHEDGE_LP_BASE_URL=https://liquidity.anyhedge.com
ANYHEDGE_DEFAULT_ORACLE_RELAY=oracles.generalprotocols.com
ANYHEDGE_DEFAULT_ORACLE_PORT=7083
ANYHEDGE_DEFAULT_ORACLE_PUBKEY=02d3c1de9d4bc77d6c3608cbe44d10138c7488e592dc2b1e10a6cf0e92c2ecb047
ANYHEDGE_SETTLEMENT_SERVICE_AUTH_TOKEN=

SIDESHIFT_SECRET_KEY=

BCHJS_TOKEN=
SERVICER_ADDR=
SERVICER_PK=
SERVICE_FEE=1000
ARBITRATION_FEE=1000

# Cauldron DEX platform fee (charged by clients on token <-> BCH swaps)
# 30 bps = 0.3%; empty address disables the fee feature
CAULDRON_FEE=30
CAULDRON_FEE_ADDRESS=
CAULDRON_FEE_MAX_USD=1.0

FERNET_KEY=

COINGECKO_API_KEY=

P2P_EXCHANGE_SLACKBOT_USER_TOKEN=
P2P_EXCHANGE_SLACK_CHANNEL=

# 32 bytes, base64 encoded. Generate with Fernet.generate_key().
STABLEHEDGE_FERNET_KEY=
STABLEHEDGE_AUTH_KEY_WALLET_WIF=

PAYTACAPOS_PAYOUT_WALLET_HASH=
PAYTACAPOS_PAYOUT_XPUBKEY=

# Token for authenticating with the NFC server when processing card registrations
NFC_SERVER_TOKEN=

# Fernet key for encrypting webhook secrets in the database
WEBHOOK_SECRET_KEY=

# Internal execution services: generate a separate token for each service.
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required in both Node services and all Python web/worker callers.
STABLEHEDGE_JS_AUTH_TOKEN=
ANYHEDGE_JS_AUTH_TOKEN=

# Additional private helper services; generate a separate token for each.
ADDRESS_JS_AUTH_TOKEN=
CTS_JS_AUTH_TOKEN=
MULTISIG_JS_AUTH_TOKEN=
